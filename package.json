{
  "name": "prompts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "wrangler dev worker.js --port 8787 --persist-to .wrangler/state",
    "build": "tsc -b && vite build && npm run audit:public",
    "audit:public": "node scripts/audit-public.mjs",
    "test:privacy": "node --test scripts/public-privacy.test.mjs",
    "preview": "vite preview",
    "cloud:setup": "node scripts/cloud-setup.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -y",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -y",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.131.0"
  }
}
